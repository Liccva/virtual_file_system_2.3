@startuml seq_4_lazy
!include _style.iuml
title Ленивая загрузка удалённого файла и кэш метаданных
actor "Клиент" as C
participant "backup_proxy :\nProtectedNodeProxy" as P #FFE0B2
participant "access :\nAclAccessService" as A #C8E6C9
participant "backup.zip :\nLazyRemoteFileProxy" as L #E1BEE7
participant "storage :\nRemoteStorage" as S #E1BEE7

== Нет права (пользователь без READ) ==
C -> P : size()
activate P
P -> A : is_allowed(user, backup.zip, READ)
A --> P : False
P -->x C : raise AccessDeniedError
deactivate P
note over L, S : LazyRemoteFileProxy не вызывается,\nзапросов к хранилищу 0

== Первое разрешённое обращение ==
C -> P : size()
activate P
P -> A : is_allowed(user, backup.zip, READ)
A --> P : True
P -> L : size()
activate L
L -> L : _load(): _metadata is None
L -> S : fetch_metadata("/backups/backup.zip")
S --> L : RemoteMetadata(size=5000)
L -> L : _metadata = результат (кэш)
L --> P : 5000
deactivate L
P --> C : 5000
deactivate P

== Повторное обращение ==
C -> P : size()
activate P
P -> A : is_allowed(user, backup.zip, READ)
A --> P : True
P -> L : size()
activate L
L -> L : _load(): метаданные из кэша
L --> P : 5000
deactivate L
P --> C : 5000
deactivate P
note over L, S : запроса к хранилищу нет
@enduml
