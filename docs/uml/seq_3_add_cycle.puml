@startuml seq_3_add_cycle
!include _style.iuml
title Защита от добавления каталога в своего потомка
actor "Клиент" as C
participant "b :\nDirectoryComposite" as B #BBDEFB
participant "a :\nDirectoryComposite" as A #BBDEFB

note over C, A : дерево уже собрано: a содержит b
C -> B : add(a)
activate B
B -> A : contains(b)
activate A
A -> B : contains(b)
activate B
B --> A : True  (node is self)
deactivate B
A --> B : True
deactivate A
B -->x C : raise InvalidTreeOperationError\n"Нельзя добавить 'a' в 'b': каталог нельзя поместить\nв самого себя или в своего потомка"
deactivate B
@enduml
